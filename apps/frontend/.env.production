# ═══════════════════════════════════════════════════════════════════════════════
# FRONTEND VERCEL DEPLOYMENT — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy these into your FRONTEND Vercel project dashboard:
#   Vercel → Project Settings → Environment Variables
#
# Vercel Project Settings:
#   Root Directory:  apps/frontend
#   Framework:       Next.js
#
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. BACKEND API URL (Required) ────────────────────────────────────────────
# The URL of your BACKEND Vercel deployment.
# This is used by the browser (client-side) to make API calls.
# ⚠️  Must include the protocol (https://).
# ⚠️  Do NOT add a trailing slash.
# ⚠️  "NEXT_PUBLIC_" prefix makes it available in client-side JavaScript.
NEXT_PUBLIC_API_URL=https://api.yourdomain.com


# ── 2. NEXTAUTH_SECRET (Required) ────────────────────────────────────────────
# Used by NextAuth v5 to sign/verify JWT session tokens.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️⚠️⚠️  THIS MUST BE THE EXACT SAME VALUE AS IN THE BACKEND DEPLOYMENT  ⚠️⚠️⚠️
NEXTAUTH_SECRET=<64-character-hex-string>


# ── 3. AUTH_SECRET (Required) ────────────────────────────────────────────────
# NextAuth v5 also reads this variable name. Set it to the SAME value.
# ⚠️  Must be identical to NEXTAUTH_SECRET above.
AUTH_SECRET=<same-64-character-hex-string-as-NEXTAUTH_SECRET>


# ── 4. NEXTAUTH_URL (Required) ───────────────────────────────────────────────
# The canonical URL of THIS frontend deployment.
# Used by NextAuth to build OAuth callback URLs.
# ⚠️  Must match your actual Vercel domain exactly.
# ⚠️  Do NOT add a trailing slash.
NEXTAUTH_URL=https://app.yourdomain.com


# ── 5. GITHUB OAUTH (Required) ───────────────────────────────────────────────
# From your GitHub OAuth App at: https://github.com/settings/developers
#
# When creating/updating the GitHub OAuth App, set:
#   Homepage URL:                https://app.yourdomain.com
#   Authorization callback URL:  https://app.yourdomain.com/api/auth/github/callback
#
# ⚠️  The callback URL format MUST be /api/auth/github/callback
GITHUB_CLIENT_ID=Ov23xxxxxxxxxxxxxx
GITHUB_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx


# ── 6. NEXT_PUBLIC_BASE_URL (Optional) ────────────────────────────────────────
# Fallback for NEXTAUTH_URL. Usually not needed if NEXTAUTH_URL is set.
# NEXT_PUBLIC_BASE_URL=https://app.yourdomain.com


# ── 7. BACKEND_INTERNAL_URL (Optional) ───────────────────────────────────────
# Override for server-side API calls from Next.js to the backend.
# Only needed if the backend has a different internal URL than NEXT_PUBLIC_API_URL.
# If not set, falls back to NEXT_PUBLIC_API_URL.
# BACKEND_INTERNAL_URL=https://api.yourdomain.com
