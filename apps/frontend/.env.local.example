# ─────────────────────────────────────────────────────────────────────────────
# Adaptive Study Tutor — Frontend Environment Variables
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── NextAuth ─────────────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3000
# Must be at least 32 random characters — SAME VALUE as backend NEXTAUTH_SECRET
NEXTAUTH_SECRET=

# ── GitHub OAuth App ─────────────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New
# Homepage URL:      http://localhost:3000
# Callback URL:      http://localhost:3000/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Backend API ───────────────────────────────────────────────────────────────
# URL of the running Hono backend. Change for production.
NEXT_PUBLIC_API_URL=http://localhost:8000
