# ─────────────────────────────────────────────────────────────────────────────
# StudyTutor — Vercel Deployment Environment Variables
# For Vercel: Add these in your project settings at vercel.com
# For local dev: Copy to apps/frontend/.env.local
# NEVER commit .env.local to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── NextAuth (Required) ──────────────────────────────────────────────────────
# Production: Set to your Vercel domain (e.g., https://your-app.vercel.app)
NEXTAUTH_URL=http://localhost:3000

# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
NEXTAUTH_SECRET=

# ── GitHub OAuth (Required) ──────────────────────────────────────────────────
# Create at: https://github.com/settings/developers → OAuth Apps → New
# For Vercel production:
#   Homepage URL:  https://your-app.vercel.app
#   Callback URL:  https://your-app.vercel.app/api/auth/callback/github
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Backend API (Optional - defaults to /api for Vercel) ────────────────────
# Leave empty or set to /api for Vercel deployment
# Only needed if you deploy backend separately
NEXT_PUBLIC_API_URL=/api

# ── MongoDB (Required) ───────────────────────────────────────────────────────
# Use MongoDB Atlas for production (free M0 tier available)
# Get connection string at: https://cloud.mongodb.com
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/studytutor?retryWrites=true&w=majority

# ── Pinecone (Required) ──────────────────────────────────────────────────────
# Create a Serverless index at https://app.pinecone.io
# Dimensions: 768 for nomic-embed-text (Ollama) OR 1536 for text-embedding-3-small (OpenAI)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=study-tutor

# ── Security Secrets (Required) ──────────────────────────────────────────────
# APP_SECRET is used to encrypt API keys stored in MongoDB
# Must be at least 32 random characters. Generate same way as NEXTAUTH_SECRET
APP_SECRET=

# ── Node Environment (Optional) ──────────────────────────────────────────────
NODE_ENV=production

# ── Cohere (Optional - enables reranking) ────────────────────────────────────
# Get API key at: https://dashboard.cohere.com
# If not provided, reranking will be skipped gracefully
COHERE_API_KEY=

# ── LLM Provider Fallback Keys (Optional) ────────────────────────────────────
# These are used as fallback when users haven't set their own API keys
# Users can override these in the app settings
KEYTAR_FALLBACK_OPENAI_KEY=
KEYTAR_FALLBACK_ANTHROPIC_KEY=

# ─────────────────────────────────────────────────────────────────────────────
# DEPLOYMENT NOTES:
# 1. User API keys (OpenAI/Anthropic) are stored encrypted in MongoDB
# 2. The KEYTAR_FALLBACK_* keys are optional shared keys for testing
# 3. For Ollama, no API key is needed (runs locally in dev only)
# 4. All secrets should be added via Vercel Dashboard → Settings → Environment Variables
# ─────────────────────────────────────────────────────────────────────────────
