# ─────────────────────────────────────────────────────────────────────────────
# Adaptive Study Tutor — Frontend Environment Variables
# Copy to .env.local for local development.
# For Vercel, set these in the project's Environment Variables dashboard.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base URL (your frontend domain) ──────────────────────────────────────────
# Local dev: http://localhost:3000
# Production: https://app.yourdomain.com  (your Vercel frontend URL)
NEXT_PUBLIC_BASE_URL=http://localhost:3000
NEXTAUTH_URL=http://localhost:3000

# ── Auth secrets ─────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  NEXTAUTH_SECRET MUST match the backend's NEXTAUTH_SECRET
NEXTAUTH_SECRET=
AUTH_SECRET=

# ── GitHub OAuth ─────────────────────────────────────────────────────────────
# Register at: https://github.com/settings/developers
# Callback URL: https://app.yourdomain.com/api/auth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# ── Backend API URL ──────────────────────────────────────────────────────────
# Points to the separate backend Vercel deployment.
# Local dev: http://localhost:8000
# Production: https://api.yourdomain.com  (your Vercel backend URL)
NEXT_PUBLIC_API_URL=http://localhost:8000

# ── Optional: Backend Internal URL ───────────────────────────────────────────
# If the backend has a different internal URL (e.g. for server-side calls),
# set it here. Defaults to NEXT_PUBLIC_API_URL if not set.
# BACKEND_INTERNAL_URL=
