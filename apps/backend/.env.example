# ─────────────────────────────────────────────────────────────────────────────
# Adaptive Study Tutor — Backend Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Server ────────────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development

# ── MongoDB ──────────────────────────────────────────────────────────────────
# MongoDB Atlas free tier (M0): mongodb+srv://<user>:<pass>@<cluster>.mongodb.net/studytutor
# Or local Docker mirror:        mongodb://localhost:27017/studytutor
MONGODB_URI=mongodb://localhost:27017/studytutor

# ── Pinecone ─────────────────────────────────────────────────────────────────
# Create a Serverless index at https://app.pinecone.io
# Dimensions: 1536 (OpenAI text-embedding-3-small) OR 768 (Ollama nomic-embed-text)
PINECONE_API_KEY=
PINECONE_INDEX_NAME=study-tutor

# ── JWT ───────────────────────────────────────────────────────────────────────
# Must be at least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
APP_SECRET=

# ── NextAuth (shared secret — must match frontend .env.local) ─────────────────
# Generate same way as APP_SECRET
NEXTAUTH_SECRET=


