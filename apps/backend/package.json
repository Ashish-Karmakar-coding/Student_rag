{
  "name": "@study-tutor/backend",
  "version": "0.1.0",
  "description": "Hono.js backend for the Adaptive Study Tutor",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc --project tsconfig.json",
    "start": "node dist/index.js",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@study-tutor/shared": "workspace:*",
    "@anthropic-ai/sdk": "^0.30.0",
    "@hono/node-server": "^1.12.0",
    "@langchain/langgraph": "^0.2.0",
    "@langchain/core": "^0.3.0",
    "@langchain/textsplitters": "^0.1.0",
    "@pinecone-database/pinecone": "^3.0.3",
    "cohere-ai": "^7.14.0",
    "dotenv": "^16.4.5",
    "hono": "^4.4.0",
    "jose": "^5.6.3",
    "mammoth": "^1.8.0",
    "marked": "^12.0.0",
    "mongoose": "^8.4.4",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1",
    "uuid": "^10.0.0",
    "wink-bm25-text-search": "^3.1.2",
    "wink-nlp": "^2.3.2",
    "wink-eng-lite-web-model": "^1.7.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.14.10",
    "@types/pdf-parse": "^1.1.4",
    "@types/uuid": "^10.0.0",
    "tsx": "^4.16.2",
    "typescript": "^5.4.5",
    "vitest": "^2.0.3"
  }
}
