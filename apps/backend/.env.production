# ═══════════════════════════════════════════════════════════════════════════════
# BACKEND VERCEL DEPLOYMENT — Environment Variables
# ═══════════════════════════════════════════════════════════════════════════════
#
# Copy these into your BACKEND Vercel project dashboard:
#   Vercel → Project Settings → Environment Variables
#
# Vercel Project Settings:
#   Root Directory:  apps/backend
#   Framework:       Other
#
# ═══════════════════════════════════════════════════════════════════════════════


# ── 1. SERVER ─────────────────────────────────────────────────────────────────
NODE_ENV=production


# ── 2. MONGODB (Required) ────────────────────────────────────────────────────
# Your MongoDB Atlas connection string.
# Get it from: MongoDB Atlas → Connect → Drivers → Copy connection string
# ⚠️  Whitelist all IPs (0.0.0.0/0) in Atlas Network Access for Vercel.
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/studytutor?retryWrites=true&w=majority


# ── 3. PINECONE (Required) ───────────────────────────────────────────────────
# Your Pinecone vector DB credentials.
# Get it from: Pinecone Dashboard → API Keys
PINECONE_API_KEY=pcsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
PINECONE_INDEX_NAME=studentrag


# ── 4. APP_SECRET (Required) ─────────────────────────────────────────────────
# Used to encrypt user API keys (AES-256-GCM) before storing in MongoDB.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️  This is ONLY needed in the backend. Do NOT add to frontend.
# ⚠️  If you change this, all previously encrypted user API keys become unreadable.
APP_SECRET=<64-character-hex-string>


# ── 5. NEXTAUTH_SECRET (Required) ────────────────────────────────────────────
# Used to verify JWT tokens sent by the frontend during /auth/sync.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ⚠️⚠️⚠️  THIS MUST BE THE EXACT SAME VALUE AS IN THE FRONTEND DEPLOYMENT  ⚠️⚠️⚠️
NEXTAUTH_SECRET=<64-character-hex-string>


# ── 6. ALLOWED_ORIGINS (Required) ────────────────────────────────────────────
# The frontend URL(s) that are allowed to make cross-origin requests.
# This is your FRONTEND Vercel deployment URL.
# For multiple origins, separate with commas (no spaces).
# ⚠️  Must include the protocol (https://).
# ⚠️  Do NOT add a trailing slash.
ALLOWED_ORIGINS=https://app.yourdomain.com


# ═══════════════════════════════════════════════════════════════════════════════
# That's ALL the backend needs. The 6 variables above are the only required ones.
#
# Users provide their own OpenAI/Anthropic API keys through the Settings page
# in the frontend UI. These get encrypted and stored in MongoDB automatically.
# ═══════════════════════════════════════════════════════════════════════════════
