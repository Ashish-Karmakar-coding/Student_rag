{
  "version": 2,
  "installCommand": "pnpm --dir ../.. install --frozen-lockfile",
  "buildCommand": "pnpm --dir ../.. --filter @study-tutor/shared build",
  "functions": {
    "api/index.ts": {
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index" }
  ]
}
