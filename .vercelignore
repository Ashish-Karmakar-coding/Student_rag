# Root-level Vercel ignore
# These files are excluded from ALL Vercel projects using this repo.
# Do NOT exclude apps/backend or apps/frontend here — each project
# needs its own files. Use per-project .vercelignore inside each app folder.

node_modules
.env.local
.env*.local
*.log
.DS_Store
tsconfig.tsbuildinfo
docker-compose.yml
test-backend.sh
